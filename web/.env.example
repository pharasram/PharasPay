# Local demo uses fictional data. Generate a random secret: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MOCK_API=true
NEXT_PUBLIC_DEMO_MODE=true
AWS_REGION=ap-south-1
# Production API must use your regional API Gateway hostname; no global URL.
API_BASE_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
# Direct GA4/Meta cannot satisfy India-only storage. Production refuses this flag.
# Development-only integration demonstration; keep false for all real customer use.
NEXT_PUBLIC_ANALYTICS_APPROVED=false
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PAYMENT_ORIGIN=
NEXT_PUBLIC_KYC_ORIGIN=
NEXT_TELEMETRY_DISABLED=1
